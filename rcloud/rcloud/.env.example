# rCloud environment variables
#
# Local development: copy to .env and run `npm run db:push && npm run db:seed`.
# Netlify: set these in Site configuration → Environment variables.
#
# Never commit the real values — `.env` and `.env*.local` are gitignored.

# Managed Postgres (Neon / Supabase / any TLS Postgres) — the same Drizzle
# schema works everywhere. Local development default uses the container Postgres.
DATABASE_URL=postgres://rcloud:rcloud_dev_password@localhost:5432/rcloud

# The canonical public address of the site, origin only (no trailing slash).
# Used for the canonical <link>, robots.txt/sitemap.xml, the structured data
# block, the "official site" line in the footer and /.well-known/security.txt —
# i.e. everything that tells a search engine and a visitor which address is the
# real rCloud. Set this on Netlify; leave it as localhost for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session integrity secret. The current session implementation mints random
# tokens and stores only their SHA-256 hashes in Postgres, so the app does not
# read this value today; it stays in the deployment checklist for future
# signed-token work. Generate with `openssl rand -hex 32`.
AUTH_SECRET=change-me-in-production

# Optional: verbose sign-in diagnostics for local troubleshooting only.
# Never enable this on the deployed site.
# RCLOUD_AUTH_DEBUG=1
